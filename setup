#!/bin/bash
#
# vim:ft=sh

apt update
apt install wireguard -y

# env PRIVATEKEY
key=${PRIVATEKEY:-private_key_not_given}
server=${SERVER:-server}
conf=wg-server.conf

curl -L https://wg.alz.ee/$server.conf > $conf

iface=$(ip r show default | awk '{print $5}')

sed -i s/IFNAME/$iface/ $conf
sed -i s/SERVER_PRIVATEKEY/$key/ $conf

mv $conf /etc/wireguard/

systemctl enable --now wg-quick@${conf%.conf}

# dante
sudo apt install -y dante-server
sudo cp /etc/danted.conf /etc/danted.conf.bak
sudo cp ash/conf/etc/danted.conf /etc/danted.conf
sudo sed -i s/eth0/$iface/ /etc/danted.conf
sudo systemctl restart danted.service
